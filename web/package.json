{
  "name": "memoire-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --port 4200",
    "build": "ng build",
    "serve": "node server/serve.mjs",
    "test": "ng test --watch=false && pnpm test:server",
    "test:server": "node --test server/*.test.mjs",
    "typecheck": "ng build --configuration development && tsc --project tsconfig.e2e.json",
    "lint": "prettier --check src server tests *.json *.ts",
    "format": "prettier --write src server tests *.json *.ts",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
